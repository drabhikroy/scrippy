<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Uninstall Scrippy</title>
    <organization>com.scrippy</organization>
    <domains enable_localSystem="false" enable_currentUserHome="true" enable_anywhere="false"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>
    <background file="background.png" mime-type="image/png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background-dark.png" mime-type="image/png" alignment="bottomleft" scaling="none"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="uninstall"/>
    </choices-outline>
    <choice id="uninstall" visible="false" title="Uninstall Scrippy">
        <pkg-ref id="com.scrippy.uninstall"/>
    </choice>
    <pkg-ref id="com.scrippy.uninstall" version="__VERSION__" onConclusion="none">Uninstall.pkg</pkg-ref>
</installer-gui-script>
